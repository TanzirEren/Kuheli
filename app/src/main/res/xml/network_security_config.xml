<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so that local providers such as OmniRoute (http://localhost) and the
     on-device bridge work. Public providers all use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
