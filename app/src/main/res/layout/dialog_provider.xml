<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp">

        <EditText
            android:id="@+id/prov_name"
            style="@style/K.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/prov_url"
            style="@style/K.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Base URL, for example https://api.groq.com/openai/v1"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/prov_key"
            style="@style/K.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API key (stored encrypted)"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/prov_model"
            style="@style/K.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Default model"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/prov_headers"
            style="@style/K.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Extra headers, one per line (Name: value)"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Test"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_models"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Fetch models"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/prov_result"
            style="@style/K.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>
</ScrollView>
